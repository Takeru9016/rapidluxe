# ── Database (Neon / Postgres) ─────────────────────────────────────────────
# Local/dev: use the pooled connection string from the Neon dashboard.
# For Vercel (serverless) deployment, append PgBouncer params to avoid
# exhausting connections on cold starts:
#   ?pgbouncer=true&connection_limit=1
# Neon's "-pooler" host already routes through PgBouncer; keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct (non-pooled) URL — used by Prisma migrations only.
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="info@rapidluxe.com"

